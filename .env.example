# --- LLM ---
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# --- Web search (optional; app degrades gracefully without it) ---
WEB_SEARCH_PROVIDER=tavily
WEB_SEARCH_API_KEY=

# --- Database ---
DATABASE_URL=sqlite:///data/app.db

# --- Retrieval ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
FAISS_INDEX_PATH=indexes/faiss
UPLOAD_FOLDER=data/uploads

# --- Safety limits ---
MAX_AGENT_ITERATIONS=3
MAX_TOOL_CALLS=20
MAX_TASKS=15
MAX_FILE_SIZE_MB=20
MAX_QUERY_LENGTH=2000

# --- Server ---
PORT=5000
FLASK_DEBUG=false
